#!/usr/bin/env bash
# fleet-init: write .claude/fleet.toml for the repo in the current directory.
# Usage: fleet-init [--dry-run] [--force] [--measure]
set -euo pipefail

dry=0 force=0 measure=0
for a in "$@"; do
  case "$a" in
    --dry-run) dry=1 ;;
    --force) force=1 ;;
    --measure) measure=1 ;;
    -h|--help) sed -n '2,3p' "$0"; exit 0 ;;
    *) echo "fleet-init: unknown flag $a" >&2; exit 2 ;;
  esac
done

root=$(git rev-parse --show-toplevel)
cd "$root"
out=.claude/fleet.toml
if [ -e "$out" ] && [ "$force" = 0 ] && [ "$dry" = 0 ]; then
  echo "fleet-init: $out exists; pass --force to overwrite or --dry-run to preview" >&2
  exit 1
fi

quick='^(lint|fmt|format|fmtcheck|check|typecheck|tc|vet|test|unit|assets|css|generate|gen)$'
slow='(e2e|integration|docker|deploy|bench|slow|release|publish|install|watch|dev|serve)'

cands=()
if f=$(ls justfile Justfile 2>/dev/null | head -1) && [ -n "$f" ]; then
  while read -r r; do cands+=("$r|just $r"); done < <(
    grep -E '^[a-zA-Z_][a-zA-Z0-9_-]*[^:=]*:([^=]|$)' "$f" | sed -E 's/[ :].*//' | sort -u)
fi
if [ -f Makefile ]; then
  while read -r r; do cands+=("$r|make $r"); done < <(
    grep -E '^[a-zA-Z_][a-zA-Z0-9_-]*:([^=]|$)' Makefile | sed -E 's/:.*//' | sort -u)
fi
if [ -f package.json ] && command -v jq >/dev/null; then
  while read -r r; do cands+=("$r|npm run $r"); done < <(jq -r '.scripts // {} | keys[]' package.json)
fi

picked=() left=()
seen=" "
for c in ${cands[@]+"${cands[@]}"}; do
  name=${c%%|*} cmd=${c#*|}
  [[ "$seen" == *" $name "* ]] && continue
  seen+="$name "
  if [[ "$name" =~ $slow ]] || ! [[ "$name" =~ $quick ]]; then
    left+=("$cmd"); continue
  fi
  if [ "$measure" = 1 ]; then
    s=$(date +%s)
    if ! bash -c "$cmd" >/dev/null 2>&1; then
      echo "fleet-init: '$cmd' failed while measuring, left out" >&2; left+=("$cmd"); continue
    fi
    t=$(( $(date +%s) - s ))
    if [ "$t" -gt 60 ]; then echo "fleet-init: '$cmd' took ${t}s, left out" >&2; left+=("$cmd"); continue; fi
  fi
  picked+=("$cmd")
done

unmatched=()
if [ -d .github/workflows ]; then
  while read -r j; do
    [ -z "$j" ] && continue
    hit=0
    for p in ${picked[@]+"${picked[@]}"}; do [[ "$p" == *"${j%%[-_]*}"* ]] && hit=1; done
    [ "$hit" = 0 ] && unmatched+=("$j")
  done < <(awk '/^jobs:/{in_j=1;next} in_j && /^[^ #]/{in_j=0} in_j && /^  [A-Za-z0-9_-]+:/{gsub(/[: ]/,"");print}' .github/workflows/*.y*ml | sort -u)
fi

body="# Written by fleet-init. Review before committing.
# ci: \"off\" ignores CI after a PR opens; \"async\" resumes the ticket's subagent once on a red run.
[checks]
pre_push = ["
for p in ${picked[@]+"${picked[@]}"}; do body+=$'\n'"  \"$p\","; done
body+=$'\n]\nci = "off"\n'

if [ "$dry" = 1 ]; then
  printf '%s\n' "$body"
else
  mkdir -p .claude
  printf '%s\n' "$body" > "$out"
  echo "fleet-init: wrote $out"
fi
[ ${#left[@]} -gt 0 ] && printf 'Left out of pre_push (slow or not a quick check): %s\n' "$(IFS=,; echo "${left[*]}")" >&2
[ ${#unmatched[@]} -gt 0 ] && printf 'CI jobs with no local equivalent: %s\n' "$(IFS=,; echo "${unmatched[*]}")" >&2
exit 0
