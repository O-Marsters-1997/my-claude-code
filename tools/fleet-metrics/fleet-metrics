#!/usr/bin/env python3 -I
"""Exploration metrics for fleet subagent transcripts.

usage: fleet-metrics <agent-*.jsonl | subagents dir> [...]
"""
import json
import re
import sys
from datetime import datetime
from pathlib import Path

READ_CMD = re.compile(r"(^|&&|;|\|\||\$\()\s*(rtk\s+(proxy\s+)?)?(cat|sed|head|tail|awk|nl|bat|wc)\b")
SEARCH_CMD = re.compile(r"(^|&&|;|\|\||\$\()\s*(rtk\s+(proxy\s+)?)?(rg|grep|egrep|ag|find|ls|tree|git\s+grep)\b")
CODEGRAPH_CMD = re.compile(r"\bcodegraph (explore|node|query|callers|callees|impact|context)\b")


def classify(name, inp):
    if name.startswith("mcp__codegraph__"):
        return "codegraph"
    if name == "Read":
        return "read"
    if name in ("Grep", "Glob"):
        return "search"
    if name == "Bash":
        cmd = inp.get("command") or ""
        if CODEGRAPH_CMD.search(cmd):
            return "codegraph"
        if READ_CMD.search(cmd):
            return "read"
        if SEARCH_CMD.search(cmd):
            return "search"
        return "other-bash"
    return "other"


def text_of(content):
    if isinstance(content, str):
        return content
    return "".join(b.get("text", "") for b in content or [] if isinstance(b, dict))


def ts(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00"))


def analyse(path):
    uses, results = {}, []
    first = last = None
    for line in open(path):
        d = json.loads(line)
        t = ts(d["timestamp"]) if d.get("timestamp") else None
        if t:
            first = first or t
            last = t
        content = d.get("message", {}).get("content")
        if not isinstance(content, list):
            continue
        for b in content:
            if b.get("type") == "tool_use":
                kind = classify(b["name"], b.get("input", {}))
                uses[b["id"]] = (b["name"], kind, b.get("input", {}))
            elif b.get("type") == "tool_result" and b.get("tool_use_id") in uses:
                name, kind, inp = uses[b["tool_use_id"]]
                label = inp.get("command") or inp.get("file_path") or inp.get("query") or inp.get("pattern") or ""
                results.append((len(text_of(b.get("content"))), name, kind, label.replace("\n", " ")[:80]))
    return uses, results, first, last


def report(path):
    uses, results, first, last = analyse(path)
    kinds = {}
    for _, kind, _ in uses.values():
        kinds[kind] = kinds.get(kind, 0) + 1
    chars = {}
    for size, _, kind, _ in results:
        chars[kind] = chars.get(kind, 0) + size
    explore = [k for k in ("codegraph", "read", "search") if k in kinds]
    print(f"== {path}")
    print(f"tool calls: {len(uses)}   exploration calls: {sum(kinds.get(k, 0) for k in explore)}")
    print(f"{'kind':<12}{'calls':>6}{'result chars':>14}")
    for k in sorted(kinds):
        print(f"{k:<12}{kinds[k]:>6}{chars.get(k, 0):>14}")
    explore_chars = sum(chars.get(k, 0) for k in explore)
    print(f"exploration result chars: {explore_chars} (~{explore_chars // 4} tokens)")
    if first and last:
        print(f"wall time: {(last - first).total_seconds():.0f}s", end="")
        print()
    print("top results:")
    for size, name, kind, label in sorted(results, reverse=True)[:10]:
        print(f"  {size:>7}  {kind:<10} {label}")
    print()


def main(argv):
    if not argv:
        sys.exit(__doc__)
    paths = []
    for a in argv:
        p = Path(a)
        paths += sorted(p.glob("agent-*.jsonl")) if p.is_dir() else [p]
    for p in paths:
        report(p)


main(sys.argv[1:])
